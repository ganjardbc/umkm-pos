{"nodes": [{"id": "ai_tasks_hotfix_rbac_cross_tenant_verify_report", "label": "HOTFIX-RBAC-CROSS-TENANT Verify Report", "file_type": "document", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hotfix_rbac_cross_tenant_fix", "label": "HOTFIX-RBAC-CROSS-TENANT: outlet-merchant ownership validation on role assign/revoke", "file_type": "concept", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assignRoleToUser and revokeRoleFromUser did not validate that dto.outlet_id belonged to the caller's merchant, enabling cross-tenant role manipulation; fixed with assertOutletBelongsToMerchant helper distinguishing NotFoundException (outlet missing) vs ForbiddenException (outlet belongs to different merchant). Fix scoped to service layer inline rather than a generic guard-level decorator to minimize blast radius across many endpoints."}, {"id": "apps_api_src_rbac_rbac_service", "label": "apps/api/src/rbac/rbac.service.ts", "file_type": "code", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_src_rbac_rbac_controller", "label": "apps/api/src/rbac/rbac.controller.ts", "file_type": "code", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_src_rbac_rbac_service_spec", "label": "apps/api/src/rbac/rbac.service.spec.ts", "file_type": "code", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assert_outlet_belongs_to_merchant_helper", "label": "assertOutletBelongsToMerchant() private helper", "file_type": "code", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hotfix_get_user_roles_followup", "label": "Follow-up needed: getUserRoles endpoint has commented permission guard + no merchant/outlet filter (cross-tenant read)", "file_type": "rationale", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different vulnerability class (cross-tenant read vs write) than the hotfixed endpoints; needs separate ticket to uncomment @RequirePermission('role.read') and add merchant/outlet scoping validation."}, {"id": "hotfix_roles_permissions_global_finding", "label": "Architectural finding: roles/permissions tables are global (no merchant_id) despite multi-tenant product", "file_type": "rationale", "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assignPermissionToRole/revokePermissionFromRole operate on global roles/permissions tables, verified not vulnerable to the same outlet_id-from-body issue since there's no merchant scoping concept there; noted as architecture debt, not urgent bug."}], "edges": [{"source": "ai_tasks_hotfix_rbac_cross_tenant_verify_report", "target": "hotfix_rbac_cross_tenant_fix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".ai/tasks/HOTFIX-RBAC-CROSS-TENANT/verify-report.md", "source_location": null, "weight": 1.0}, {"source": "hotfix_rbac_cross_tenant_fix", "target": "assert_outlet_belongs_to_merchant_helper", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".ai/tasks/HOT