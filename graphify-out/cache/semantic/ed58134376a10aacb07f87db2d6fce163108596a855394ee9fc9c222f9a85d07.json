{"nodes": [{"id": "ai_workflows_piv_workflow", "label": "PIV Workflow (Plan-Implement-Verify retry tiers)", "file_type": "document", "source_file": ".ai/workflows/piv-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "piv_level1_internal_retry", "label": "PIV Level 1: internal agent retry loop (max 3x)", "file_type": "concept", "source_file": ".ai/workflows/piv-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "piv_level2_gate_retry", "label": "PIV Level 2: QA gate / Reviewer gate retry (max 1x each, independent counters)", "file_type": "concept", "source_file": ".ai/workflows/piv-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counters are independent local `let` variables per gate, fresh each job run via scoping, not shared budget with Level 1 or Level 3; when exhausted the pipeline returns cleanly (not throws) and posts a Linear comment."}, {"id": "piv_level3_bullmq_retry", "label": "PIV Level 3: BullMQ job/queue retry (attempts: 3, infra failures only)", "file_type": "concept", "source_file": ".ai/workflows/piv-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only triggers on thrown exceptions/crashes (network timeout, process crash); gate-exhausted quality failures use `return` deliberately so BullMQ does not treat them as job failures and does not retry the whole pipeline."}, {"id": "run_agent_pipeline_use_case", "label": "run-agent-pipeline.use-case.ts", "file_type": "code", "source_file": ".ai/workflows/piv-workflow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "caf_md_doc", "label": "CAF.md \u00a7 Pola Kerja: PIV / Retry Bertingkat", "file_type": "document", "source_file": ".ai/w